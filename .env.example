# Supabase public browser connection. Keep secret/service-role keys out of this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only PromptPay identifier used to generate exact-amount QR payloads.
PROMPTPAY_ID=
# Server-only Cloudflare R2 S3 API credentials and private slip bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PAYMENT_SLIPS_BUCKET=
# Server-only Supabase secret key used exclusively by the payment upload gateway RPCs.
SUPABASE_SECRET_KEY=
