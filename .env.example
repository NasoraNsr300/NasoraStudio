# Add public environment variables here when they are introduced.

# Server-only PromptPay identifier used to generate exact-amount QR payloads.
PROMPTPAY_ID=
# Server-only Cloudflare R2 S3 API credentials and private slip bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PAYMENT_SLIPS_BUCKET=
# Server-only Supabase secret key used exclusively by the payment upload gateway RPCs.
SUPABASE_SECRET_KEY=
