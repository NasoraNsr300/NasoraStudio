# Supabase public browser connection. Keep secret/service-role keys out of this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only PromptPay identifier used to generate exact-amount QR payloads.
PROMPTPAY_ID=
# Server-only Cloudflare R2 S3 API credentials and private slip bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PAYMENT_SLIPS_BUCKET=
# Private message, progress, delivery, catalog, document, and portfolio media.
R2_PRIVATE_ASSETS_BUCKET=
# Server-only Supabase secret key used exclusively by the payment upload gateway RPCs.
SUPABASE_SECRET_KEY=

# Server-only email delivery and scheduled maintenance configuration.
BREVO_API_KEY=
ADMIN_EMAIL_SENDER=
CRON_SECRET=
NASORA_BASE_URL=https://your-worker.example

# One ordinary member account for repeatable end-to-end checks. Never use an Admin email.
TEST_CUSTOMER_EMAIL=customer.test@nasora.local
# Set locally only. Minimum 12 characters; never commit a real password.
TEST_CUSTOMER_PASSWORD=
