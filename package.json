{
  "name": "nasora-public",
  "version": "1.0.0",
  "description": "Nasora web application",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/measure-public-performance.mjs",
    "test:customer:reset": "node --env-file=.env.local scripts/reset-test-customer.mjs",
    "build": "node scripts/build-vercel.mjs",
    "start": "next start",
    "vercel:link": "npx --yes vercel@59.1.4 link",
    "vercel:pull": "npx --yes vercel@59.1.4 pull --yes --environment=preview",
    "vercel:build": "npx --yes vercel@59.1.4 build"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@lexical/history": "0.48.0",
    "@lexical/link": "0.48.0",
    "@lexical/list": "0.48.0",
    "@lexical/react": "0.48.0",
    "@lexical/rich-text": "0.48.0",
    "@lexical/selection": "0.48.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "lexical": "0.48.0",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
